<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="0001-insert-contacts" author="victor">
        <comment>Insert three default contacts: Toto, Tata, Titi</comment>

        <insert tableName="contact">
            <column name="username" value="Toto"/>
            <column name="password" value="password1"/>
            <column name="email" value="toto@example.com"/>
        </insert>

        <insert tableName="contact">
            <column name="username" value="Tata"/>
            <column name="password" value="password2"/>
            <column name="email" value="tata@example.com"/>
        </insert>

        <insert tableName="contact">
            <column name="username" value="Titi"/>
            <column name="password" value="password3"/>
            <column name="email" value="titi@example.com"/>
        </insert>

    </changeSet>

</databaseChangeLog>

